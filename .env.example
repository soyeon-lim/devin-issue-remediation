# Devin API (https://app.devin.ai -> Settings -> API Keys)
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxx
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxx

# GitHub personal access token with "repo" scope (used to comment on issues)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
GITHUB_REPO=owner/repo

# 1 = do not call Devin / GitHub, just print the exact request bodies (default)
# 0 = really create Devin sessions and post issue comments
DRY_RUN=1
